<?xml version="1.0" encoding="utf-8"?>
<!-- 헤더 + 스크롤 컨테이너, 그 위에 예약 등록 버튼이 떠 있다.
     바깥은 merge: 액티비티가 이미 FrameLayout(content)으로 감싸므로 한 단계를 겹쳐 두지 않는다 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 헤더. 선택(삭제) 모드에선 제목 자리에 [전체 … 삭제] 바가 겹쳐 나온다 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="20dp"
                android:text="볼륨예약"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- 좌우 44dp = 목록 여백 20 + 카드 안쪽 24: 전체 체크는 카드 체크와, 삭제는 스위치 끝과 맞춘다 -->
            <LinearLayout
                android:id="@+id/selection_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="44dp"
                android:paddingTop="8dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/select_all"
                    style="@style/RoundCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="전체"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 선택 모드를 닫고 목록으로 돌아간다(뒤로가기와 같음) -->
                <TextView
                    android:id="@+id/cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:text="취소"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 컨테이너가 화면 폭 전체라 스크롤바가 카드가 아닌 화면 끝에 생긴다 -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="20dp"
                android:scrollbarStyle="outsideOverlay">

                <!-- 예약 항목(item_reservation)이 시간순으로 들어간다.
                     아래 여백은 마지막 항목이 떠 있는 버튼에 가리지 않게. ScrollView 패딩에 두면
                     카드 위에서 시작한 스와이프를 ScrollView가 가로채지 않아 여기 둔다 -->
                <LinearLayout
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="104dp" />
            </ScrollView>

            <TextView
                android:id="@+id/empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="예약된 볼륨조절이 없어요"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- 하단 플로팅 버튼: 일반 모드는 예약 등록, 선택 모드는 삭제 -->
    <LinearLayout
        android:id="@+id/add"
        style="@style/FloatingPill"
        android:background="@drawable/bg_key_button">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_plus" />

        <TextView
            style="@style/FloatingPillText"
            android:text="예약 등록" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/delete"
        style="@style/FloatingPill"
        android:background="@drawable/bg_light_button"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete" />

        <TextView
            style="@style/FloatingPillText"
            android:text="삭제" />
    </LinearLayout>

    <!-- 저장 후 3초 알림(토스트 대신). 예약 등록 버튼 위에 뜬다. liveRegion으로 화면 낭독기도 읽는다 -->
    <TextView
        android:id="@+id/notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="100dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_notice"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />
</merge>
