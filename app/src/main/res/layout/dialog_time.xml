<?xml version="1.0" encoding="utf-8"?>
<!-- 바깥이 포커스를 받아야 창이 뜰 때 숫자 칸이 선택된 채로 시작하지 않는다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:theme="@style/Picker.AmPm" />

        <NumberPicker
            android:id="@+id/hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/Picker" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text=":"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <NumberPicker
            android:id="@+id/minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/Picker" />
    </LinearLayout>

    <!-- 반복 요일. 순서가 요일 비트(bit0=일)와 같아야 한다. 아무것도 안 고르면 한 번만 -->
    <LinearLayout
        android:id="@+id/days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <CheckBox style="@style/DayToggle" android:text="일" />
        <CheckBox style="@style/DayToggle" android:text="월" />
        <CheckBox style="@style/DayToggle" android:text="화" />
        <CheckBox style="@style/DayToggle" android:text="수" />
        <CheckBox style="@style/DayToggle" android:text="목" />
        <CheckBox style="@style/DayToggle" android:text="금" />
        <CheckBox style="@style/DayToggle" android:text="토" />
    </LinearLayout>

    <!-- 예약 시각에 맞출 음악 볼륨 0~100%. 0%는 음소거.
         좌우 6dp는 요일 원·바텀 버튼 끝선에 맞춘 값 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="볼륨 설정"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/volume_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 트랙 양끝을 6dp 선에 맞추고, 끝에 간 손잡이(반지름 10dp, 12dp까지 여유)가 잘리지 않게
         여백 12dp를 두고 그만큼 바깥으로 뺀다(-6dp). 바깥은 부모 clipToPadding=false로 그려진다.
         SeekBar 기본 스타일의 paddingStart/End(16dp)가 paddingHorizontal을 덮어쓰고,
         layout_marginHorizontal은 음수를 무시해서 둘 다 Start/End로 지정 -->
    <SeekBar
        android:id="@+id/volume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="-6dp"
        android:contentDescription="음악 볼륨"
        android:maxHeight="8dp"
        android:minHeight="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:progressDrawable="@drawable/seekbar_track"
        android:splitTrack="false"
        android:thumb="@drawable/seekbar_thumb" />

    <!-- 켜면 예약 볼륨으로 바로 가지 않고 한 단계씩 다가간다(8단계 이상이면 0.05초, 아니면 0.1초 간격) -->
    <CheckBox
        android:id="@+id/fade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:text="페이드"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />
</LinearLayout>
