<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="14dp">

    <!-- 선택(삭제) 모드에서만 보인다. 누르기는 카드 전체가 받는다 -->
    <CheckBox
        android:id="@+id/check"
        style="@style/RoundCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- 예약이 꺼지면 이 영역 전체를 어둡게(alpha) 한다.
         아래 7dp는 숫자 위 빈 공간(폰트 기준선~대문자 높이)만큼 보정: 글자가 보이는 그대로 카드 세로 가운데에 오고,
         스위치·체크는 카드 정가운데에 그대로 둔다 -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="7dp">

        <!-- 원UI처럼 작은 오전/오후 + 큰 시각, 글자 밑선 맞춤 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="오후" />

            <!-- includeFontPadding=false: 폰트가 악센트 자리로 위에 남기는 여백을 없애 숫자가 카드 세로 가운데에 오게 -->
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                tools:text="10:00" />
        </LinearLayout>

        <!-- (시계) 반복 주기  (스피커) 볼륨 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/repeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_clock"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="매일" />

            <TextView
                android:id="@+id/volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_speaker"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="음소거" />
        </LinearLayout>
    </LinearLayout>

    <Switch
        android:id="@+id/enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="예약 켜기"
        android:switchMinWidth="52dp" />
</LinearLayout>
